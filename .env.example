# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloud Functions base URL for backend calls (ThirdSpaceCMS / legacy)
VITE_CF_BASE_URL=

# Builder-specific Cloud Functions base URL (pinFileToIPFS, generateAIProject)
VITE_BUILDER_CF_BASE_URL=

# Pinata IPFS — credentials are now server-side (Firebase Secrets)
# VITE_GATEWAY_URL is still needed for reading from IPFS gateway
VITE_GATEWAY_URL=

# Legacy Pinata/token fallbacks (optional — used by tokenManager.js if server-side tokens unavailable)
# VITE_PINATA_JWT=
# VITE_WEB3_TOKEN=
# VITE_FIREBASE_TOKEN=

# Solana RPC endpoint (defaults to devnet if not set)
VITE_SOLANA_RPC_URL=

# Helius (Solana RPC provider)
VITE_HELIUS_API_KEY=
VITE_HELIUS_RPC_URL=

# Unstoppable Domains login
VITE_UD_CLIENT_ID=
VITE_UD_REDIRECT_URI=

# Solana admin wallet for payment processing
VITE_SOLANA_ADMIN_WALLET=

# Ethereum RPC endpoint (defaults to public RPC if not set)
VITE_ETH_RPC_URL=

# Encryption key for sensitive data
VITE_ENCRYPTION_KEY=

# SNS reverse lookup
VITE_REVERSE_LOOKUP_URL=

# Sentry error monitoring (optional — errors silently ignored if not set)
VITE_SENTRY_DSN=
